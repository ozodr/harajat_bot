# Telegram Bot Token - @BotFather dan oling
BOT_TOKEN=your_telegram_bot_token_here

# SQLite database path.
# Railway'da volume ulangan bo'lsa bo'sh qoldiring —
# baza avtomatik ravishda volume ichida saqlanadi.
DATABASE_PATH=finance.db

# Mini App uchun ochiq HTTPS manzil (lokalda ngrok manzili).
# Railway'da bo'sh qoldiring — domen avtomatik aniqlanadi.
WEBAPP_URL=

# Mini App serveri porti.
# Railway'da BU O'ZGARUVCHINI O'RNATMANG — Railway o'zi beradi.
PORT=8080
